# Google AI Studio API key
GEMINI_API_KEY=replace_me

# LLM-Subtrans source checkout
LLM_SUBTRANS_DIR=./vendor/llm-subtrans

# Models (verify availability for your Google AI Studio project)
TRANSLATION_MODEL=gemini-2.5-flash
TRANSCRIPTION_MODEL=gemini-3.5-transcribe
TRANSCRIPTION_PROVIDER=Gemini

# Optional USD prices per 1,000,000 tokens for the models above.
# Set both input/output rates to enable estimates; blank means unknown, not free.
TRANSLATION_INPUT_USD_PER_MILLION=
TRANSLATION_OUTPUT_USD_PER_MILLION=
TRANSCRIPTION_INPUT_USD_PER_MILLION=
TRANSCRIPTION_OUTPUT_USD_PER_MILLION=

# Optional internal API key. Leave blank for local-only testing.
SERVICE_API_KEY=

MAX_UPLOAD_MB=1024
MAX_WORKERS=2
DATA_DIR=./data

# Bounded worker queue (total accepted = MAX_WORKERS + MAX_PENDING_JOBS)
MAX_PENDING_JOBS=8
# Max duration per LLM-Subtrans CLI invocation
SUBPROCESS_TIMEOUT_SECONDS=1800
# Cleanup of completed/failed job records and output files
JOB_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MAX_SUBTITLE_MB=10
ENABLE_ALIGN=true
ENABLE_DIARIZE=true
